---
import { Icon } from 'astro-icon/components';

interface Props {
  heading?: string;
  message?: string;
}

const {
  heading = 'Schnelle Rückmeldung garantiert',
  message = 'Wir antworten auf alle Anfragen innerhalb von 24 Stunden. Die meisten Angebote gehen innerhalb von 2-4 Stunden raus.',
} = Astro.props;
---

<div class="bg-primary-50 border border-primary-200 p-5 rounded-lg">
  <div class="flex items-start gap-3">
    <Icon name="bi:clock-history" class="w-7 h-7 text-primary-600 shrink-0" />
    <div>
      <h4 class="font-heading font-bold text-base text-secondary-600 mb-1">{heading}</h4>
      <p class="text-gray-600 text-sm font-light leading-relaxed">{message}</p>
    </div>
  </div>
</div>
