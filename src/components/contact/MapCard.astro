---
interface Props {
  address?:   string;
  cityState?: string;
  mapsUrl?:   string;
}

const {
  address   = 'Musterstraße 1',
  cityState = '40210 Düsseldorf',
  mapsUrl   = 'https://www.google.com/maps/place/D%C3%BCsseldorf/@51.2217226,6.6738947,12z',
} = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <div class="h-64 relative">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d80071.74378862497!2d6.6738947!3d51.2217226!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47b8c31c5b3bbdb9%3A0xca7df72d3e4e0e7!2sD%C3%BCsseldorf!5e0!3m2!1sde!2sde!4v1"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="w-full h-full"
    ></iframe>
  </div>
  <div class="p-4 flex items-center justify-between">
    <div class="text-sm text-gray-600">
      <div class="font-semibold text-secondary-600">{address}</div>
      <div class="text-gray-500">{cityState}</div>
    </div>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-primary-600 text-sm font-semibold hover:gap-3 transition-all">
      In Google Maps öffnen
    </a>
  </div>
</div>
