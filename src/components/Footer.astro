---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import Logo from './ui/Logo.astro';
import type { FooterLink, SocialLink } from '@src/data/homepageData';
import { footerLinks, footerServices, socialLinks } from '@src/data/homepageData';

interface Props {
  description?: string;
  links?:       FooterLink[];
  services?:    FooterLink[];
  socials?:     SocialLink[];
}

const {
  description = 'Professionelle Reinigungsdienstleistungen für kirchliche Einrichtungen in Köln, Düsseldorf und dem Ruhrgebiet.',
  links    = footerLinks,
  services = footerServices,
  socials  = socialLinks,
} = Astro.props;
---

<footer class="bg-secondary-600 text-primary-100 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-12 mb-12">

      <!-- Brand -->
      <div class="col-span-2 lg:pe-12">
        <div class="mb-4"><Logo variant="light" /></div>
        <p class="text-sm font-light leading-relaxed text-primary-200 mb-5">{description}</p>
        <div class="flex gap-3">
          {socials.map((s) => (
            <a href={s.href} class="w-9 h-9 border border-secondary-400 flex items-center justify-center text-primary-300 hover:bg-primary-400 hover:text-secondary-600 hover:border-primary-400 transition-all rounded">
              <Icon name={s.icon} class="w-4 h-4" />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading font-bold text-sm tracking-widest uppercase text-white mb-5">Navigation</h4>
        <ul class="space-y-3">
          {links.map((l) => (
            <li><a href={url(l.href)} class="text-sm font-light text-primary-200 hover:text-gray-100 transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-bold text-sm tracking-widest uppercase text-white mb-5">Leistungen</h4>
        <ul class="space-y-3">
          {services.map((s) => (
            <li><a href={url(s.href)} class="text-sm font-light text-primary-200 hover:text-gray-100 transition-colors">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-span-2 lg:col-span-1">
        <h4 class="font-heading font-bold text-sm tracking-widest uppercase text-white mb-5">Kontakt</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-sm font-light text-primary-200">
            <Icon name="bi:geo-alt" class="w-4 h-4 text-primary-400 mt-0.5 shrink-0" />
            <span>Musterstraße 1, 40210 Düsseldorf</span>
          </li>
          <li class="flex items-center gap-3 text-sm font-light text-primary-200">
            <Icon name="bi:telephone" class="w-4 h-4 text-primary-400 shrink-0" />
            <a href="tel:+492110000000" class="hover:text-primary-400 transition-colors">+49 211 000 0000</a>
          </li>
          <li class="flex items-center gap-3 text-sm font-light text-primary-200">
            <Icon name="bi:envelope" class="w-4 h-4 text-primary-400 shrink-0" />
            <a href="mailto:info@firmenname.de" class="hover:text-primary-400 transition-colors">info@[firmenname].de</a>
          </li>
          <li class="flex items-start gap-3 text-sm font-light text-primary-200">
            <Icon name="bi:clock" class="w-4 h-4 text-primary-400 shrink-0 mt-0.5" />
            <span>Mo.–Fr. 7–19 Uhr<br /><span class="text-primary-300 text-xs">Notfalleinsätze nach Absprache</span></span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-secondary-400 pt-8 flex flex-col items-center text-center">
      <div class="flex flex-wrap text-sm text-primary-200 mb-4">
        <a href={url('/privacy')} class="px-3 hover:text-gray-100">Datenschutz</a>
        <a href={url('/terms')}   class="px-3 hover:text-gray-100">AGB</a>
      </div>
      <p class="text-sm font-light text-primary-200">&copy; 2026 [Firmenname]. Alle Rechte vorbehalten.</p>
    </div>
  </div>
</footer>
