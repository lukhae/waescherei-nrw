---
import { Icon } from 'astro-icon/components';
---

<button
  onclick="window.scrollTo({top:0,behavior:'smooth'})"
  x-data="{ show: false }"
  @scroll.window="show = window.pageYOffset > 300"
  x-show="show"
  style="display:none;"
  aria-label="Back to top"
  class="fixed bottom-4 right-4 w-10 h-10 md:w-12 md:h-12 bg-primary-400 hover:bg-primary-300 text-white rounded-lg shadow-2xl flex items-center justify-center z-40 transition"
>
  <Icon name="bi:arrow-up" class="w-5 h-5 text-secondary-600" />
</button>
