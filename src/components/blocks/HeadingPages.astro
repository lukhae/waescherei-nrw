---
import { Icon } from 'astro-icon/components';

interface Props {
  title:       string;
  badge?:      string;
  icon?:       string;
  lastUpdated?: string;
}

const {
  title,
  badge       = 'Legal',
  icon        = 'bi:shield-check',
  lastUpdated,
} = Astro.props;
---

<section class="py-16 bg-gray-100 relative overflow-hidden bg-waves">
  <div class="max-w-4xl mx-auto px-6 relative z-10">
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-100 border border-primary-300 text-secondary-600 text-xs font-semibold tracking-widest uppercase mb-6 rounded">
      <Icon name={icon} class="w-4 h-4" /> {badge}
    </div>
    <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-6xl text-secondary-600 leading-tight mb-4">
      {title}
    </h1>
    {lastUpdated && (
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span class="flex items-center gap-1.5">
          <Icon name="bi:calendar3" class="w-4 h-4 text-primary-600" />
          Last Updated: {lastUpdated}
        </span>
      </div>
    )}
  </div>
</section>
