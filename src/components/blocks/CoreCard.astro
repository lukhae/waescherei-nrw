---
import { Icon } from 'astro-icon/components';
import type { CoreValueItem } from '@src/data/aboutData';

type Props = CoreValueItem;

const { icon, title, desc } = Astro.props;
---

<div class="bg-white border border-gray-200 p-6 rounded-lg hover:border-primary-400 hover:shadow-md transition-all duration-200">
  <div class="w-12 h-12 bg-primary-50 flex items-center justify-center rounded-lg mb-4">
    <Icon name={icon} class="w-6 h-6 text-secondary-600" />
  </div>
  <h3 class="font-heading font-bold text-xl text-secondary-600 mb-2">{title}</h3>
  <p class="text-gray-500 text-base font-light leading-relaxed">{desc}</p>
</div>
