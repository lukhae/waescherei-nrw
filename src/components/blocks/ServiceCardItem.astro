---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';

interface Props {
  slug:     string;
  title:    string;
  badge?:   string;
  image:    string;
  excerpt:  string;
  price:    string;
  features: string[];
}

const { slug, title, badge, image, excerpt, price, features } = Astro.props;
const href = url(`/services/${slug}`);
---

<div class="service-card bg-white border border-gray-200 relative overflow-hidden group rounded-lg flex flex-col">
  <div class="overflow-hidden h-44 relative">
    <a href={href}>
      <img src={url(image)} alt={title} class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" />
    </a>
    {badge && (
      <span class="absolute top-3 right-3 bg-primary-300 text-secondary-600 text-xs font-bold tracking-wide uppercase px-3 py-1 rounded">{badge}</span>
    )}
  </div>
  <div class="p-7 flex flex-col flex-1">
    <h3 class="font-heading font-bold text-xl text-secondary-600 hover:text-primary-600 mb-2">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-gray-500 text-sm mb-4 leading-snug">{excerpt}</p>
    <ul class="space-y-2 mb-5 flex-1 text-sm text-gray-600">
      {features.map((f) => (
        <li class="flex items-center gap-2">
          <Icon name="bi:check2" class="w-4 h-4 text-secondary-600 shrink-0" />
          <span set:html={f} />
        </li>
      ))}
    </ul>
    <div class="flex items-center justify-between pt-4 border-t border-gray-100 mt-auto">
      <div>
        <div class="text-xs text-gray-400 uppercase tracking-wide">Starting at</div>
        <div class="font-heading font-bold text-base text-secondary-600">{price}</div>
      </div>
      <a href={href} class="inline-flex items-center gap-2 text-secondary-600 text-sm font-semibold hover:gap-3 hover:text-primary-600 transition-all">
        Details <Icon name="bi:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary-400 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
</div>
