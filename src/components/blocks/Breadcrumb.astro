---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs:   Crumb[];
  variant?: 'light' | 'dark';
  center?:  boolean;
}

const { crumbs, variant = 'light', center = true } = Astro.props;

const linkCls  = variant === 'light'
  ? 'text-primary-200 hover:text-white transition-colors'
  : 'text-gray-500 hover:text-secondary-600 transition-colors';

const activeCls = variant === 'light' ? 'text-white' : 'text-secondary-600 font-semibold';
const iconCls   = variant === 'light' ? 'text-primary-300' : 'text-gray-400';

// Helper function untuk membatasi teks menjadi 3 kata
const truncateText = (text: string, maxWords: number = 3): string => {
  const words = text.trim().split(/\s+/);
  if (words.length <= maxWords) return text;
  return words.slice(0, maxWords).join(' ') + '...';
};
---

<nav class:list={['flex items-center gap-2 text-sm', center ? 'justify-center' : '']}>
  {crumbs.map((crumb, i) => (
    <>
      {i > 0 && <Icon name="bi:chevron-right" class:list={['w-3 h-3', iconCls]} />}
      {crumb.href && i < crumbs.length - 1
        ? <a href={url(crumb.href)} class={linkCls}>{truncateText(crumb.label)}</a>
        : <span class={activeCls}>{truncateText(crumb.label)}</span>
      }
    </>
  ))}
</nav>