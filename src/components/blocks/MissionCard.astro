---
import { Icon } from 'astro-icon/components';
import type { MissionCardData } from '@src/data/aboutData';

type Props = MissionCardData;

const { icon, title, body } = Astro.props;
---

<div class="bg-secondary-500 p-8 rounded-lg relative overflow-hidden">
  <div class="absolute right-0 top-0 w-32 h-full bg-primary-400 opacity-10 -skew-x-12 translate-x-12"></div>
  <div class="relative z-10">
    <div class="w-14 h-14 bg-primary-400/20 flex items-center justify-center rounded-lg mb-5">
      <Icon name={icon} class="w-7 h-7 text-primary-300" />
    </div>
    <h3 class="font-heading font-bold text-2xl text-white mb-3">{title}</h3>
    <p class="text-primary-100 font-light text-base leading-relaxed">{body}</p>
  </div>
</div>
