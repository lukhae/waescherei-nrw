---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import type { ServiceItem } from '@src/data/homepageData';

type Props = ServiceItem;

const { image, alt, title, excerpt, features, href } = Astro.props;
---

<div class="service-card bg-white border border-gray-200 relative overflow-hidden group rounded-lg flex flex-col">
  <div class="overflow-hidden h-44">
    <a href={url(href)}>
      <img src={url(image)} alt={alt} class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" />
    </a>
  </div>
  <div class="p-7 flex flex-col flex-1">
    <h3 class="font-heading font-bold text-xl text-secondary-600 hover:text-primary-600 mb-2">
      <a href={url(href)}>{title}</a>
    </h3>
    <p class="text-gray-500 text-sm mb-4 leading-snug">{excerpt}</p>
    <ul class="space-y-2 mb-6 flex-1 text-sm text-gray-600">
      {features.map((f) => (
        <li class="flex items-center gap-2">
          <Icon name="bi:check2" class="w-4 h-4 text-secondary-600 shrink-0" /> {f}
        </li>
      ))}
    </ul>
    <a href={url(href)} class="inline-flex items-center gap-2 mt-auto text-secondary-600 text-sm font-semibold hover:gap-3 hover:text-primary-600 transition-all">
      Mehr erfahren <Icon name="bi:arrow-right" class="w-4 h-4" />
    </a>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary-400 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
</div>
