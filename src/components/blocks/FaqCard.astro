---
interface Props {
  question: string;
  answer:   string;
  index:    number;
}
const { question, answer, index } = Astro.props;
---
<div class="border border-gray-200 rounded-lg overflow-hidden">
  <button class="w-full flex items-center justify-between p-6 text-left bg-white hover:bg-gray-50 transition-colors"
    @click={`open === ${index} ? open = null : open = ${index}`}>
    <span class="font-heading font-bold text-lg text-secondary-600">{question}</span>
    <span class="shrink-0 text-primary-400 text-xl transition-transform"
      :class={`open === ${index} ? 'text-red-400' : ''`}
      x-text={`open === ${index} ? '−' : '+'`}></span>
  </button>
  <div x-show={`open === ${index}`} x-transition class="px-6 pb-6">
    <p class="text-gray-600 font-light text-base leading-relaxed">{answer}</p>
  </div>
</div>
