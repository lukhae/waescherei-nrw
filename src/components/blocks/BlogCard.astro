---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from '@src/data/homepageData';
type Props = BlogPost;
const { image, date, title, href } = Astro.props;
---
<div class="group block bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
  <div class="overflow-hidden h-40">
    <a href={url(href)}>
      <img src={url(image)} alt={title} class="w-full h-auto group-hover:scale-105 transition-transform duration-500" />
    </a>
  </div>
  <div class="p-5">
    <h3 class="font-heading font-bold text-base text-secondary-600 leading-snug mb-3 group-hover:text-primary-600 transition-colors">
      <a href={url(href)}>{title}</a>
    </h3>
    <div class="flex items-center text-sm text-gray-500 gap-2">
      <Icon name="bi:calendar" class="w-4 h-4" /> <span>{date}</span>
    </div>
  </div>
</div>
