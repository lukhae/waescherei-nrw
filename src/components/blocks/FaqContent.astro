---
import type { FaqItem } from '@src/data/homepageData';
import { faqs as defaultFaqs } from '@src/data/homepageData';
import { Icon } from "astro-icon/components";

interface Props {
  faqs?:    FaqItem[];
  badge?:   string;
  heading?: string;
}

const {
  faqs    = defaultFaqs,
  badge   = 'FAQ',
  heading = 'Frequently Asked Questions',
} = Astro.props;
---
<div class="flex flex-col gap-4 mt-12">
    <div class="relative">
        <span class="inline-block py-1 px-4 rounded-full bg-primary-100 text-secondary-600 text-xs font-semibold tracking-widest uppercase mb-3">{badge}</span>
        <h2 class="font-heading text-2xl font-bold text-gray-900">{heading}</h2>
    </div>
    <div class="space-y-4" x-data="{ open: null }">
    {faqs.map((faq, i) => (
        <div class="border rounded-lg bg-gray-50">
            <button
                class="w-full px-4 py-3 text-left flex justify-between items-center focus:outline-none"
                @click={`open === ${i} ? open = null : open = ${i}`}
            >
                <span class="font-medium font-heading">{faq.q}</span>
                <Icon
                    name="bi:chevron-down"
                    class="w-5 h-5 transition-transform duration-200"
                    :class={`open === ${i} ? 'transform rotate-180' : ''`}
                />
            </button>
            <div x-show={`open === ${i}`} class="px-4 py-3 border-t">
                {faq.a}
            </div>
        </div>
    ))}
    </div>
</div>