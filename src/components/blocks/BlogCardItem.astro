---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';

interface Props {
  slug:          string;
  title:         string;
  excerpt:       string;
  image:         string;
  categoryLabel: string;
  date:          string;
  readTime:      string;
  author:        string;
  avatar:        string;
  compact?:      boolean;
}

const { slug, title, excerpt, image, categoryLabel, date, readTime, author, avatar, compact = false } = Astro.props;
const href = url(`/blogs/${slug}`);
---

<article class="group bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-md hover:border-primary-400 transition-all duration-200 flex flex-col">
  <a href={href} class:list={['relative overflow-hidden block', compact ? 'h-44' : 'h-48']}>
    <img src={url(image)} alt={title} class="w-full h-auto group-hover:scale-105 transition-transform duration-500" />
    <span class="absolute top-3 left-3 bg-white text-secondary-600 text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded">{categoryLabel}</span>
  </a>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      <span class="flex items-center gap-1">
        <Icon name="bi:calendar" class="w-3.5 h-3.5" /> {date}
      </span>
      <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
      <span class="flex items-center gap-1">
        <Icon name="bi:clock" class="w-3.5 h-3.5" /> {readTime}
      </span>
    </div>
    <h3 class="font-heading font-bold text-lg text-secondary-600 leading-snug mb-3 group-hover:text-primary-600 transition-colors">
      <a href={href}>{title}</a>
    </h3>
    {!compact && (
      <p class="text-gray-500 text-sm font-light leading-relaxed mb-4 flex-1">{excerpt}</p>
    )}
    <div class="flex items-center justify-between pt-4 border-t border-gray-100 mt-auto">
      <div class="flex items-center gap-2">
        <img src={url(avatar)} alt={author} class="w-7 h-7 object-cover rounded-full" />
        <span class="text-xs font-semibold text-secondary-600">{author}</span>
      </div>
      <a href={href} class="text-secondary-600 text-sm font-semibold hover:text-primary-600 transition-colors inline-flex items-center gap-1">
        Read <Icon name="bi:arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</article>
