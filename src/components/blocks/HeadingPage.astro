---
import { Icon } from 'astro-icon/components';
import Breadcrumb from './Breadcrumb.astro';
import type { HeadingPageData } from '@src/data/aboutData';

interface Props {
  data: HeadingPageData;
  breadcrumbVariant?: 'light' | 'dark';
}

const { data, breadcrumbVariant = 'light' } = Astro.props;
---

<section class="hero-bg py-20 relative overflow-hidden">
  <div class="absolute inset-0 opacity-5" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:60px 60px;"></div>
  <div class="absolute right-0 top-0 w-1/3 h-full bg-primary-400 opacity-10 -skew-x-12 translate-x-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-400/20 border border-primary-300 text-primary-200 text-xs font-semibold tracking-widest uppercase mb-6 anim-up rounded">
      <Icon name={data.icon} class="w-4 h-4" /> {data.badge}
    </div>
    <h1 class="font-heading font-bold text-5xl sm:text-6xl lg:text-7xl text-white leading-[1.1] tracking-tight mb-4 anim-up-2">
      {data.heading}
    </h1>
    <p class="text-primary-100 text-lg font-light leading-relaxed max-w-2xl mx-auto mb-6 anim-up-3">
      {data.description}
    </p>
    <div class="anim-up-4">
      <Breadcrumb crumbs={data.breadcrumb} variant={breadcrumbVariant} />
    </div>
  </div>
</section>
