---
interface Props {
  variant?: 'light' | 'dark';
  class?:   string;
}

const { variant = 'light' } = Astro.props;
const textColor  = variant === 'light' ? '#ffffff' : '#1E2630';
const subColor   = '#1E70DE';           // Royalblau
const knotColor  = variant === 'light' ? '#1E2630' : '#ffffff';
---

<div class="flex items-center gap-3">
  <!-- Butler-Fliege -->
  <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="22" cy="22" r="21" fill={subColor} opacity="0.14" />
    <path d="M21 22 L9 15 Q7 14 7 16.5 V27.5 Q7 30 9 29 L21 22 Z" fill={subColor} />
    <path d="M23 22 L35 15 Q37 14 37 16.5 V27.5 Q37 30 35 29 L23 22 Z" fill={subColor} />
    <rect x="19.5" y="18.5" width="5" height="7" rx="1.5" fill={knotColor} />
  </svg>

  <div class="flex flex-col leading-none gap-0.5">
    <span style={`color: ${textColor}; font-family: var(--font-body); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em;`}>Wäschebutler</span>
    <span style={`color: ${subColor}; font-family: var(--font-body); font-weight: 500; font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase;`}>Düsseldorf</span>
  </div>
</div>
