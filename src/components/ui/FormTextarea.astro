---
interface Props {
  label:       string;
  name:        string;
  placeholder?: string;
  rows?:       number;
  required?:   boolean;
  model?:      string;
}
const { label, name, placeholder = '', rows = 4, required = false, model } = Astro.props;
---
<div>
  <label class="block text-xs font-semibold text-secondary-400 uppercase tracking-wide mb-1">{label}{required && ' *'}</label>
  <textarea name={name} rows={rows} placeholder={placeholder} x-model={model}
    class="w-full border border-gray-300 px-4 py-3 text-sm focus:outline-none focus:border-primary-400 bg-white resize-none rounded"></textarea>
</div>
