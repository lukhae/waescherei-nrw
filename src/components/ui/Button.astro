---
type Variant = 'primary' | 'outline-white' | 'white' | 'ghost';

interface Props {
  href?:    string;
  variant?: Variant;
  class?:   string;
  type?:    'button' | 'submit' | 'reset';
  full?:    boolean;
}

const { href, variant = 'primary', class: extra = '', type = 'button', full = false } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-semibold transition-all rounded-full';
const sizes = 'px-7 py-4 text-sm tracking-wide';
const fullCls = full ? 'w-full' : 'max-sm:flex max-sm:w-full';

const variants: Record<Variant, string> = {
  'primary':      'bg-gradient-to-r from-primary-500 to-primary-700 text-white hover:brightness-110 shadow-lg',
  'outline-white':'border border-white text-white hover:bg-white hover:text-secondary-600',
  'white':        'bg-white text-primary-700 hover:bg-primary-50',
  'ghost':        'bg-primary-600 text-white hover:bg-primary-700',
};

const cls = [base, sizes, fullCls, variants[variant], extra].join(' ');
---

{href
  ? <a href={href} class={cls}><slot /></a>
  : <button type={type} class={cls}><slot /></button>
}
