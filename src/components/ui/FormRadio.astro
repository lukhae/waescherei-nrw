---
interface Option {
  value:   string;
  label:   string;
}

interface Props {
  label:    string;
  name:     string;
  options:  Option[];
  checked?: string;
}

const { label, name, options, checked } = Astro.props;
---

<div>
  <label class="block text-sm font-semibold text-secondary-600 mb-3">{label}</label>
  <div class="flex flex-wrap gap-4">
    {options.map((opt) => (
      <label class="inline-flex items-center cursor-pointer">
        <input
          type="radio"
          name={name}
          value={opt.value}
          checked={opt.value === checked}
          class="mr-2"
        />
        <span class="text-sm text-gray-700">{opt.label}</span>
      </label>
    ))}
  </div>
</div>
