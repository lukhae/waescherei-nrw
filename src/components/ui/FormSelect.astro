---
interface Props {
  label:    string;
  name:     string;
  options:  string[];
  required?: boolean;
  model?:   string;
}
const { label, name, options, required = false, model } = Astro.props;
---
<div>
  <label class="block text-xs font-semibold text-secondary-400 uppercase tracking-wide mb-1">{label}{required && ' *'}</label>
  <select name={name} x-model={model} class="w-full border border-gray-300 px-4 py-3 text-sm focus:outline-none focus:border-primary-400 bg-white appearance-none rounded">
    <option value="">Select {label.toLowerCase()}...</option>
    {options.map((o) => <option>{o}</option>)}
  </select>
</div>
