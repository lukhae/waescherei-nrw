---
import { url } from '@src/utils/path';

interface Props {
  image: string;
  alt:   string;
}

const { image, alt } = Astro.props;
---

<section class="pb-12 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <img src={url(image)} alt={alt} class="w-full h-75 md:h-120 object-cover rounded-lg shadow-xl" />
  </div>
</section>
