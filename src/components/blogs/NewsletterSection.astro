---
import { Icon } from 'astro-icon/components';
---

<section class="py-20 bg-secondary-500 bg-waves relative overflow-hidden">
  <div class="absolute right-0 top-0 w-1/3 h-full bg-primary-400 opacity-10 -skew-x-12 translate-x-20"></div>
  <div class="max-w-4xl mx-auto px-6 relative z-10 text-center"
    x-data="{ email: '', submitted: false, submit(){ this.submitted = true } }">
    <span class="inline-block py-1 px-4 rounded-full bg-primary-600 text-primary-100 text-xs font-semibold tracking-widest uppercase mb-3">Aktuell bleiben</span>
    <h2 class="font-heading font-bold text-4xl lg:text-5xl text-white leading-tight mb-4">Monatliche Einblicke</h2>
    <p class="text-primary-100 font-light text-lg leading-relaxed max-w-xl mx-auto mb-8">
      Hygieneanforderungen, Branchennews und praktische Tipps für kirchliche Einrichtungen. Eine E-Mail pro Monat, kein Spam.
    </p>

    <div x-show="!submitted" class="max-w-md mx-auto">
      <div class="flex flex-col sm:flex-row gap-3">
        <input x-model="email" type="email" placeholder="ihre@email.de"
          class="flex-1 border border-secondary-400 bg-secondary-400/30 text-white placeholder:text-primary-200 px-5 py-3.5 text-sm focus:outline-none focus:border-primary-400 rounded" />
        <button @click="submit()"
          class="inline-flex justify-center items-center gap-2 px-6 py-3.5 bg-primary-300 text-secondary-600 text-sm font-bold hover:bg-primary-200 transition rounded whitespace-nowrap">
          Anmelden <Icon name="bi:arrow-right" class="w-4 h-4" />
        </button>
      </div>
      <p class="text-primary-200 text-xs font-light mt-3 flex items-center justify-center gap-2">
        <Icon name="bi:shield-check" class="w-4 h-4" /> Jederzeit abmeldbar.
      </p>
    </div>

    <div x-show="submitted" x-cloak class="max-w-md mx-auto p-5 bg-primary-400/20 border border-primary-400 rounded-lg">
      <Icon name="bi:check-circle-fill" class="w-8 h-8 text-primary-300 mx-auto mb-2" />
      <div class="text-white font-semibold">Anmeldung erfolgreich!</div>
      <div class="text-primary-200 text-sm font-light mt-1">Bitte prüfen Sie Ihr Postfach zur Bestätigung.</div>
    </div>
  </div>
</section>
