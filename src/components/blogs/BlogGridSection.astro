---
import { url } from '@src/utils/path';
import BlogCardItem from '@src/components/blocks/BlogCardItem.astro';
import Pagination   from '@src/components/blocks/Pagination.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts:       CollectionEntry<'blog'>[];
  totalPosts:  number;
  currentPage: number;
  totalPages:  number;
  baseUrl:     string;
}

const { posts, totalPosts, currentPage, totalPages, baseUrl } = Astro.props;
---

<section class="py-20 bg-gray-100">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Heading -->
    <div class="grid sm:grid-cols-2 gap-3 sm:gap-12 items-center mb-12">
      <div>
        <span class="inline-block py-1 px-4 rounded-full bg-primary-100 text-secondary-600 text-xs font-semibold tracking-widest uppercase mb-3">Blogs</span>
        <h2 class="font-heading font-bold text-4xl lg:text-5xl text-secondary-600 leading-tight max-w-md">Latest Blog Posts</h2>
      </div>
      <p class="text-gray-500 font-light text-lg sm:text-right leading-relaxed">
        Total {totalPosts} Articles
      </p>
    </div>

    <!-- Grid -->
    {posts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogCardItem
            slug={post.id}
            title={post.data.title}
            excerpt={post.data.excerpt}
            image={post.data.image}
            categoryLabel={post.data.categoryLabel}
            date={post.data.date}
            readTime={post.data.readTime}
            author={post.data.author}
            avatar={post.data.avatar}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-500 mt-4">No posts found.</p>
      </div>
    )}

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={baseUrl} />
  </div>
</section>
