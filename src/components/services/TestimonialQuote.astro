---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';

interface Props {
  text:   string;
  name:   string;
  role:   string;
  avatar: string;
}

const { text, name, role, avatar } = Astro.props;
---

<blockquote class="relative mt-12 p-8 bg-secondary-500 rounded-lg overflow-hidden">
  <div class="absolute top-4 right-6 text-primary-400/20">
    <Icon name="bi:quote" class="w-24 h-24" />
  </div>
  <div class="relative z-10">
    <p class="text-white font-light text-lg italic leading-relaxed mb-5">"{text}"</p>
    <footer class="flex items-center gap-3">
      <img src={url(avatar)} alt={name} class="w-11 h-11 object-cover rounded-full border-2 border-primary-300" />
      <div>
        <div class="font-semibold text-white text-sm">{name}</div>
        <div class="text-primary-200 text-xs font-light">{role}</div>
      </div>
    </footer>
  </div>
</blockquote>
