---
import { Icon } from 'astro-icon/components';

interface Props {
  heading?:     string;
  description?: string;
  items:        string[];
}

const {
  heading     = 'Was bei jedem Einsatz inbegriffen ist',
  description = 'Jeder Reinigungseinsatz folgt einem standardisierten Reinigungsplan, den wir gemeinsam mit Ihnen bei der ersten Besichtigung entwickeln.',
  items,
} = Astro.props;
---

<div class="mb-12">
  <h2 class="font-heading font-bold text-3xl text-secondary-600 leading-tight mb-4">{heading}</h2>
  <p class="text-gray-600 font-light text-base leading-relaxed mb-6">{description}</p>
  <div class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
    {items.map((item) => (
      <div class="flex items-start gap-2 py-1.5 text-sm text-gray-700 border-b border-gray-100">
        <Icon name="bi:check2" class="w-4 h-4 text-primary-600 shrink-0 mt-0.5" />
        <span set:html={item} />
      </div>
    ))}
  </div>
</div>
