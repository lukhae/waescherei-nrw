---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';

interface Props {
  image:        string;
  alt:          string;
  badge?:       string;
  icon?:        string;
  servingCount?: string;
}

const { image, alt, badge, icon, servingCount } = Astro.props;
---

<div class="relative mb-10 rounded-lg overflow-hidden shadow-xl">
  <img src={url(image)} alt={alt} class="w-full h-105 object-cover" />
  {(badge || icon) && (
    <div class="absolute top-6 left-6 flex items-center gap-2 px-4 py-2 bg-primary-300 text-secondary-600 text-xs font-bold tracking-widest uppercase rounded">
      {icon && <Icon name={icon} class="w-4 h-4" />} {badge}
    </div>
  )}
  {servingCount && (
    <div class="absolute bottom-6 right-6 bg-secondary-500 px-5 py-3 shadow-xl rounded-lg">
      <div class="text-primary-200 text-xs tracking-wide">Serving</div>
      <div class="font-heading font-bold text-2xl text-primary-400">{servingCount}</div>
    </div>
  )}
</div>
