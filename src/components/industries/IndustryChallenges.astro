---
import { Icon } from 'astro-icon/components';

interface Props {
  heading?:    string;
  challenges:  string[];
}

const { heading = 'Common Cleaning Challenges', challenges } = Astro.props;

const challengesJson = JSON.stringify(challenges);
---

<div class="bg-gray-100 border-l-4 border-primary-400 p-7 rounded-r-lg mb-12" x-data={`{ challenges: ${challengesJson} }`}>
  <div class="flex items-center gap-2 mb-4">
    <Icon name="bi:exclamation-triangle-fill" class="w-5 h-5 text-primary-600" />
    <h3 class="font-heading font-bold text-lg text-secondary-600">{heading}</h3>
  </div>
  <div class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
    {challenges.map((challenge) => (
      <div class="flex items-center gap-2 text-sm text-gray-700">
        <Icon name="bi:chevron-right" class="w-3 h-3 text-primary-600 shrink-0" />
        <span set:html={challenge}></span>
      </div>
    ))}
  </div>
</div>
