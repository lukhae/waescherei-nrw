---
import { Icon } from 'astro-icon/components';

interface MetaStat { icon: string; label: string; value: string; }

interface Props {
  stats: MetaStat[];
}

const { stats } = Astro.props;
---

<div class="flex items-center gap-4 text-sm text-gray-500 mb-4 flex-wrap">
  {stats.map((s, i) => (
    <>
      {i > 0 && <span class="w-1 h-1 bg-gray-300 rounded-full"></span>}
      <span class="flex items-center gap-1.5">
        <Icon name={s.icon} class="w-4 h-4 text-primary-600" /> {s.value}
      </span>
    </>
  ))}
</div>
