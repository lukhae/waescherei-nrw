---
import { Icon } from 'astro-icon/components';

interface Props {
  heading?:     string;
  description?: string;
  items:        string[];
}

const {
  heading     = "What's Included",
  description = 'Our standard package covers everything your facility needs on a recurring basis. Add-ons are available as needed.',
  items,
} = Astro.props;

const itemsJson = JSON.stringify(items);
---

<div class="mb-12" x-data={`{ items: ${itemsJson} }`}>
  <h2 class="font-heading font-bold text-3xl text-secondary-600 leading-tight mb-4">{heading}</h2>
  <p class="text-gray-600 font-light text-base leading-relaxed mb-6">{description}</p>
  <div class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
    {items.map(item => (
      <div class="flex items-start gap-2 py-1.5 text-sm text-gray-700 border-b border-gray-100">
        <Icon name="bi:check2" class="text-primary-600 shrink-0 mt-0.5 text-sm" />
        <span set:html={item}></span>
      </div>
    ))}
  </div>
</div>
