---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import type { StoryData } from '@src/data/aboutData';
import { story as defaultStory } from '@src/data/aboutData';

interface Props { data?: StoryData; }
const { data = defaultStory } = Astro.props;
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">

    <!-- Image col -->
    <div class="relative">
      <img src={url(data.image)} alt={data.alt} class="w-full h-auto object-cover rounded-lg shadow-2xl" />
      <div class="absolute -bottom-8 sm:-bottom-6 right-6 sm:-right-6 bg-secondary-500 p-5 shadow-xl rounded-lg text-center">
        <div class="font-heading font-bold text-4xl text-primary-400">{data.accolade1.value}</div>
        <div class="text-white text-xs tracking-wide">{data.accolade1.label}</div>
      </div>
      <div class="absolute top-6 left-6 bg-primary-300 px-4 py-3 rounded-lg">
        <div class="font-heading font-bold text-3xl text-secondary-600">{data.accolade2.value}</div>
        <div class="text-xs text-secondary-600">{data.accolade2.label}</div>
      </div>
    </div>

    <!-- Text col -->
    <div>
      <span class="inline-block py-1 px-4 rounded-full bg-primary-100 text-secondary-600 text-xs font-semibold tracking-widest uppercase mb-3">{data.badge}</span>
      <h2 class="font-heading font-bold text-4xl lg:text-5xl text-secondary-600 leading-tight max-w-md mb-6">{data.heading}</h2>
      <div class="space-y-4 text-gray-600 font-light text-base leading-relaxed mb-8">
        {data.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="grid grid-cols-2 gap-4">
        {data.badges.map((b) => (
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-100 flex items-center justify-center rounded-lg shrink-0">
              <Icon name={b.icon} class="w-5 h-5 text-secondary-600" />
            </div>
            <div>
              <div class="font-semibold text-secondary-600 text-sm">{b.title}</div>
              <div class="text-gray-500 text-xs">{b.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
