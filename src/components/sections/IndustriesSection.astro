---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import HeadingSection from '@src/components/blocks/HeadingSection.astro';
import type { IndustryItem } from '@src/data/homepageData';

interface Props {
  industries: IndustryItem[];
  heading?:   string;
  badge?:     string;
  desc?:      string;
}

const {
  industries,
  heading = 'Unsere Leistungen',
  badge   = 'Was wir tun',
  desc    = 'Von der täglichen Unterhaltsreinigung bis zur spezialisierten Sakralreinigung. Alles aus einer Hand.',
} = Astro.props;
---

<section id="industries" class="py-20 bg-gray-100">
  <div class="max-w-7xl mx-auto px-6">
    <HeadingSection badge={badge} heading={heading} description={desc} align="center" />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {industries.map((ind) => (
        <a href={url(ind.href)} class="block">
          <div class="bg-white border border-gray-200 p-6 rounded-lg hover:border-primary-400 hover:shadow-md transition-all duration-200">
            <div class="w-12 h-12 bg-primary-50 flex items-center justify-center rounded-lg mb-4">
              <Icon name={ind.icon} class="w-6 h-6 text-secondary-600" />
            </div>
            <h3 class="font-heading font-bold text-xl text-secondary-600 mb-2">{ind.label}</h3>
            <p class="text-gray-500 text-base font-light leading-relaxed">{ind.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
