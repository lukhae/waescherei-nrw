---
import { url } from '@src/utils/path';
import { Icon } from 'astro-icon/components';
import Button from '@src/components/ui/Button.astro';
import type { HeroData } from '@src/data/homepageData';
import { hero as defaultHero } from '@src/data/homepageData';

interface Props { data?: HeroData; }
const { data = defaultHero } = Astro.props;
const statsJson = JSON.stringify(data.stats);
---

<section class="hero-bg flex flex-col items-center relative overflow-hidden">
  <div class="absolute inset-0 opacity-5" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:60px 60px;"></div>
  <div class="absolute right-0 top-0 w-1/3 h-full bg-primary-400 opacity-10 -skew-x-12 translate-x-20"></div>

  <div class="max-w-7xl mx-auto px-6 py-14 grid lg:grid-cols-2 gap-12 items-center relative z-10">
    <div>
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-400/20 border border-primary-300 text-primary-200 text-xs font-semibold tracking-widest uppercase mb-6 anim-up rounded">
        <Icon name="bi:stars" class="w-4 h-4" /> {data.badge}
      </div>
      <h1 class="font-heading font-bold text-5xl sm:text-6xl lg:text-7xl text-white leading-[1.1] tracking-tight mb-3 anim-up-2">
        <span>{data.heading[0]}</span><br />
        <span class="text-primary-400">{data.heading[1]}</span>
      </h1>
      <p class="text-primary-100 text-lg font-light leading-relaxed mb-8 max-w-lg anim-up-3">{data.description}</p>
      <div class="flex flex-wrap gap-4 anim-up-4">
        <Button href={data.ctaPrimary.href} variant="primary">
          <Icon name={data.ctaPrimary.icon} class="w-4 h-4" /> {data.ctaPrimary.label}
        </Button>
        <Button href={data.ctaPhone.href} variant="outline-white">
          <Icon name="bi:telephone-fill" class="w-4 h-4" /> {data.ctaPhone.label}
        </Button>
      </div>
    </div>

    <div class="relative hidden lg:block">
      {data.images && data.images.length >= 4
        ? (
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <img src={url(data.images[0])} alt="Menschen, die sich freuen" class="w-full h-44 lg:h-56 object-cover object-top rounded-2xl shadow-lg" />
              <img src={url(data.images[2])} alt="Wäschebutler holt die Wäsche ab" class="w-full h-44 lg:h-56 object-cover rounded-2xl shadow-lg" />
            </div>
            <div class="space-y-4 pt-10">
              <img src={url(data.images[1])} alt="Persönlicher Wäscheservice" class="w-full h-44 lg:h-56 object-cover rounded-2xl shadow-lg" />
              <img src={url(data.images[3])} alt="Zufriedene Seniorin" class="w-full h-44 lg:h-56 object-cover rounded-2xl shadow-lg" />
            </div>
          </div>
        )
        : data.image
        ? <img src={url(data.image)} alt={data.badge} class="w-full h-auto object-cover rounded-lg shadow-2xl" />
        : (
          <div class="relative rounded-2xl border border-primary-400/30 bg-gradient-to-br from-secondary-400/40 to-secondary-600/40 p-10 shadow-2xl backdrop-blur">
            <svg width="72" height="72" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-6" aria-hidden="true">
              <path d="M21 22 L9 15 Q7 14 7 16.5 V27.5 Q7 30 9 29 L21 22 Z" fill="#4A90F0" />
              <path d="M23 22 L35 15 Q37 14 37 16.5 V27.5 Q37 30 35 29 L23 22 Z" fill="#4A90F0" />
              <rect x="19.5" y="18.5" width="5" height="7" rx="1.5" fill="#ffffff" />
            </svg>
            <div class="space-y-4">
              {['Wir holen ab', 'Wir waschen & trocknen', 'Wir falten', 'Wir bringen zurück'].map((t) => (
                <div class="flex items-center gap-3 text-white">
                  <Icon name="bi:check-circle-fill" class="w-5 h-5 text-primary-400 shrink-0" />
                  <span class="text-lg font-light">{t}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      <!-- Badge oben rechts (nur ohne Collage) -->
      {!(data.images && data.images.length >= 4) && (
        <div class="absolute -top-6 -right-6 bg-primary-400 p-5 shadow-xl rounded-lg text-center">
          <div class="font-heading font-bold text-3xl text-secondary-600">{data.award.value}</div>
          <div class="text-secondary-600 text-xs font-semibold tracking-wide">{data.award.label}</div>
        </div>
      )}
    </div>
  </div>

  <!-- Stats bar -->
  <div class="w-full relative bg-secondary-500 bg-waves" x-data={`{ stats: ${statsJson} }`}>
    <div class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-2 lg:grid-cols-4 gap-6">
      {data.stats.map(stat => (
        <div class="text-center">
          <div class="font-heading font-bold text-2xl text-white mb-1">{stat.num}</div>
          <div class="text-sm text-gray-100 tracking-wide">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- weicher Wellen-Trenner in die naechste (helle) Sektion -->
  <div class="w-full bg-secondary-500 leading-none">
    <svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="block w-full h-12 md:h-20" xmlns="http://www.w3.org/2000/svg">
      <path fill="#F1F4FA" d="M0,40 C360,95 1080,-5 1440,45 L1440,90 L0,90 Z"></path>
    </svg>
  </div>
</section>
