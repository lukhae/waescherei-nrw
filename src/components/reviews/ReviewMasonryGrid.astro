---
import { url } from '@src/utils/path';
import type { ReviewItem } from '@src/data/reviewsData';
import { Icon } from 'astro-icon/components';

interface Props {
  reviews: ReviewItem[];
}
const { reviews } = Astro.props;
const reviewsJson = JSON.stringify(reviews.map(r => ({ ...r, avatar: url(r.avatar) })));
---

<div
  x-data={`{
    reviews: ${reviewsJson},
    get filtered() {
      return $store.reviewFilter === 'all'
        ? this.reviews
        : this.reviews.filter(r => r.service === $store.reviewFilter);
    }
  }`}
  @filter-change.window="$store.reviewFilter = $event.detail"
>
  <!-- Grid -->
  <div class="columns-1 md:columns-2 lg:columns-3 gap-6" x-show="filtered.length > 0">
    <template x-for="review in filtered" :key="review.name + review.date">
      <div class="break-inside-avoid mb-6 bg-white border border-gray-200 p-6 rounded-lg hover:shadow-md hover:border-primary-400 transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <div class="flex gap-0.5">
            <template x-for="s in 5" :key="s">
              <Icon name="bi:star-fill" class="text-amber-400 text-sm" :class="s > review.rating ? 'opacity-20' : ''" />
            </template>
          </div>
          <span class="text-xs text-gray-400" x-text="review.date"></span>
        </div>
        <p class="text-gray-600 font-light text-base leading-relaxed mb-5 italic"
           x-text="'\u201c' + review.text + '\u201d'"></p>
        <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
          <img :src="review.avatar" :alt="review.name" class="w-10 h-10 object-cover rounded-full border-2 border-primary-200" />
          <div class="flex-1">
            <div class="font-semibold text-secondary-600 text-sm" x-text="review.name"></div>
            <div class="text-gray-500 text-xs font-light" x-text="review.role"></div>
          </div>
          <span class="inline-block px-2 py-1 bg-primary-50 text-secondary-600 text-xs font-semibold rounded capitalize"
                x-text="review.service.replace('-', ' ')"></span>
        </div>
      </div>
    </template>
  </div>

  <!-- Empty state -->
  <div x-show="filtered.length === 0" class="text-center py-12">
    <Icon name="bi:inbox" class="text-5xl text-gray-300" />
    <p class="mt-4 text-gray-500">No reviews found for this category yet.</p>
  </div>
</div>
