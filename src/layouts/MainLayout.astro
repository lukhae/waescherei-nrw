---
import { Font } from 'astro:assets';
import Header from '@src/components/Header.astro';
import Footer from '@src/components/Footer.astro';
import BackToTop from '@src/components/BackToTop.astro';
import { Icon } from 'astro-icon/components';

import 'glightbox/dist/css/glightbox.min.css';
import '@src/styles/style.css';

interface Props {
  title?:       string;
  description?: string;
}

const {
  title       = 'Reinigung im Raum der Kirchen — Professionelle Reinigung in NRW',
  description = 'Spezialisierte Reinigungsdienstleistungen für Kirchen, Caritas, Diakonie und kirchliche Einrichtungen in Köln, Düsseldorf und dem Ruhrgebiet.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="[Firmenname]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url?.href || 'https://cleaning.madethemes.com'} />
    <link rel="icon" type="image/x-icon" href="/img/favicon.png" />

    <!-- Astro Font API  -->
    <Font cssVariable="--font-body"    preload />
    <slot name="head" />
  </head>

  <body class="bg-white text-secondary-600 antialiased pt-24">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <!-- Alpine.js -->
    <script>
      import Alpine from 'alpinejs';
      declare global { interface Window { Alpine: typeof Alpine; } }
      window.Alpine = Alpine;
      Alpine.start();
    </script>

    <!-- GLightbox -->
    <script>
      import GLightbox from 'glightbox';
      const hasLightbox = document.querySelector('.glightbox');
      if (hasLightbox) {
        GLightbox({ selector: '.glightbox', touchNavigation: true, loop: true });
      }
    </script>

    <script src="@src/scripts/cursor.ts"></script>
  </body>
</html>
