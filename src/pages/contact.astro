---
import MainLayout    from '@layouts/MainLayout.astro';
import HeadingPage    from '@src/components/blocks/HeadingPage.astro';
import ContactSection from '@src/components/sections/ContactSection.astro';

const headingData = {
  badge:       'Kontakt aufnehmen',
  icon:        'bi:envelope',
  heading:     'Sprechen Sie uns an',
  description: 'Ob privat oder mit Pflegegrad: Schreiben Sie uns kurz, worum es geht. Wir melden uns zeitnah bei Ihnen, meistens noch am selben Tag.',
  breadcrumb:  [{ label: 'Startseite', href: '/' }, { label: 'Kontakt' }],
};
---

<MainLayout
  title="Kontakt — Wäschebutler Düsseldorf"
  description="Fragen Sie Ihren Wäscheservice in Düsseldorf an. Privat oder über den Entlastungsbetrag mit Pflegegrad. Wir melden uns zeitnah."
>
  <HeadingPage data={headingData} />
  <ContactSection />
</MainLayout>
